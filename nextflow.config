manifest {
    name            = 'spatial-tme-pipeline'
    description     = 'Visium QC -> SVGs -> cell2location deconvolution -> TME neighborhood enrichment'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
}

params {
    // inputs (fetch with scripts/download_data.py)
    h5ad            = "${projectDir}/data/visium_breast_cancer.h5ad"
    ref_h5ad        = "${projectDir}/data/wu2021_breast_atlas.h5ad"
    // set to a previously trained reference_signatures.h5ad to skip REFERENCE_SIGNATURES
    ref_signatures  = null
    outdir          = "${projectDir}/results"

    // QC / normalization / SVG
    min_genes       = 200
    max_mito_pct    = 20.0
    n_top_genes     = 2000
    n_top_svgs      = 50

    // cell2location
    celltype_col    = 'celltype_major'
    batch_col       = 'donor_id'
    ref_max_epochs  = 250
    max_epochs      = 500
    accelerator     = 'gpu'

    // TME mapping
    n_perms         = 1000

    // resource caps (lower --max_memory on a laptop)
    max_cpus        = 16
    max_memory      = 64.GB
    max_time        = 24.h

    // SLURM (used by -profile slurm)
    cpu_queue       = 'short'
    gpu_queue       = 'gpu'
    gpu_type        = null   // e.g. 'v100' -> --gres=gpu:v100:1
}

includeConfig 'conf/base.config'

profiles {
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled  = true
        conda.useMamba = true
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}
