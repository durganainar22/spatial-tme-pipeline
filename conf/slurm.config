// SLURM executor (tested target: Northeastern Explorer). Override queues with
// --cpu_queue / --gpu_queue / --gpu_type to match your cluster.
executor {
    name      = 'slurm'
    queueSize = 10
}

process {
    executor = 'slurm'
    queue    = params.cpu_queue

    // selected by name, not label: a second withLabel:gpu block would replace
    // the resources set in base.config instead of merging with them
    withName: 'REFERENCE_SIGNATURES|DECONVOLUTION' {
        queue          = params.gpu_queue
        clusterOptions = "--gres=gpu:${params.gpu_type ? params.gpu_type + ':' : ''}1"
    }
}
