// Default resources, capped by --max_cpus / --max_memory / --max_time.
// Retries on out-of-memory / kill exit codes with more memory.
process {
    resourceLimits = [cpus: params.max_cpus, memory: params.max_memory, time: params.max_time]

    cpus          = 1
    memory        = { 4.GB * task.attempt }
    time          = { 1.h * task.attempt }
    errorStrategy = { task.exitStatus in [137, 138, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    withLabel: process_medium {
        cpus   = 2
        memory = { 6.GB * task.attempt }
    }
    withLabel: gpu {
        cpus   = 4
        memory = { 32.GB * task.attempt }
        time   = { 8.h * task.attempt }
    }
}
